#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
USE_PROCD=1
START=99
STOP=01

GENERATE_UC=/usr/share/singbox-ui/generate.uc
SUBSCRIPTION_UC=/usr/share/singbox-ui/subscription.uc
RULESETS_UC=/usr/share/singbox-ui/nft-rulesets.uc
NFTABLES_UC=/usr/share/singbox-ui/nftables.uc
APPLY_PLUGINS_UC=/usr/share/singbox-ui/apply-plugins.uc
# Overridable so tests can point the self-heal seed at the in-tree copy.
SEED_RULESETS_SH="${SEED_RULESETS_SH:-/usr/share/singbox-ui/seed-rulesets.sh}"
UCODE_LIB=/usr/share/singbox-ui/lib
# Overridable so tests can stub the binary (default is the packaged path used by
# the procd command below). Used for both `check` (S6.1) and `run`.
SINGBOX_BIN="${SINGBOX_BIN:-/usr/bin/sing-box}"

# --- Service-lifecycle lock (missed-1) -------------------------------------
# Every daemon-mutating path funnels through this script: boot `start`, the
# rpcd `restart` method (→ `reload`), and BOTH */15 cron jobs (subscription.uc
# and nft-rulesets.uc each shell out to `<init> reload`). Without
# serialization two stop+start cycles can interleave and leave sing-box down
# or double-started, or an nft apply can race a half-written restart. We
# serialize with an atomic mkdir lock-DIRECTORY — busybox ash has no flock and
# `>` is not exclusive, so mkdir is the atomic primitive (same approach as
# nftables.uc's apply-lock). Re-entrant within ONE process via a depth counter
# so reload_service can hold the lock across its nested stop+start. A stale
# lock (holder crashed mid-cycle) is reclaimed after LC_LOCK_TTL so it can
# never wedge boot/cron forever.
LC_LOCK_DIR=/tmp/singbox-ui/.lifecycle.lock
LC_LOCK_TTL="${SINGBOX_LIFECYCLE_TTL:-120}"

_lc_acquire() {
	_LC_DEPTH=$(( ${_LC_DEPTH:-0} + 1 ))
	[ "$_LC_DEPTH" -gt 1 ] && return 0   # already held by this process
	_LC_OWNED=0                          # becomes 1 only once WE create the dir
	mkdir -p /tmp/singbox-ui
	_lc_i=0
	while :; do
		if mkdir "$LC_LOCK_DIR" 2>/dev/null; then
			echo $$ > "$LC_LOCK_DIR/pid" 2>/dev/null
			_LC_OWNED=1
			return 0
		fi
		# Stale-lock reclaim: steal a lock dir older than the TTL, but ONLY when
		# its holder is actually gone (crashed). A live but slow holder (a long
		# stop+start past the TTL) keeps its lock instead of being stolen, which
		# would otherwise let two lifecycle cycles run concurrently.
		_lc_now=$(date +%s)
		_lc_mt=$(date -r "$LC_LOCK_DIR" +%s 2>/dev/null || echo "$_lc_now")
		if [ $(( _lc_now - _lc_mt )) -ge "$LC_LOCK_TTL" ]; then
			_lc_pid=$(cat "$LC_LOCK_DIR/pid" 2>/dev/null)
			if [ -z "$_lc_pid" ] || ! kill -0 "$_lc_pid" 2>/dev/null; then
				logger -t singbox-ui "lifecycle lock stale (holder ${_lc_pid:-?} gone) — reclaiming"
				rm -rf "$LC_LOCK_DIR" 2>/dev/null
				continue
			fi
		fi
		_lc_i=$(( _lc_i + 1 ))
		if [ "$_lc_i" -ge "$LC_LOCK_TTL" ]; then
			# Waited a full TTL without acquiring — proceed rather than wedge
			# boot/cron forever, but WITHOUT ownership (_LC_OWNED stays 0): we
			# never created the dir, so _lc_release must not delete the real
			# holder's lock.
			logger -t singbox-ui "lifecycle lock wait timed out — proceeding without the lock"
			return 0
		fi
		sleep 1
	done
}

_lc_release() {
	_LC_DEPTH=$(( ${_LC_DEPTH:-0} - 1 ))
	[ "${_LC_DEPTH:-0}" -gt 0 ] && return 0   # still held by an outer caller
	_LC_DEPTH=0
	# Only remove the lock dir if THIS process created it. A timed-out acquire
	# proceeded without ownership; deleting the dir here would destroy the real
	# holder's lock and break mutual exclusion exactly under contention.
	[ "${_LC_OWNED:-0}" = "1" ] && rm -rf "$LC_LOCK_DIR" 2>/dev/null
	_LC_OWNED=0
}

start_service() {
	_lc_acquire
	__do_start
	_ss_rc=$?
	_lc_release
	return "$_ss_rc"
}

# The reload hook was wired to every path EXCEPT the one operators actually use:
# both */15 cron jobs and subscription.uc call `<init> reload`, but a UI
# "Save & Apply" only does `uci commit` + `ubus uci apply`. procd fires a config
# reload from that apply ONLY for a service that registered a trigger, and this
# one never did — so a committed setting sat in /etc/config while the daemon kept
# running the OLD /tmp/singbox-ui.json until a manual Restart, the next cron tick,
# or a reboot. Two operator-visible symptoms fall out of that one gap:
#   - disable a tproxy inbound, Apply -> the `inet singbox_ui` table lingers,
#     because start_service's "nft not needed -> remove" reconcile never runs;
#   - change anything, Apply, reboot -> it looks like the change "did nothing"
#     until the reboot, which is when the daemon finally re-reads /etc/config.
# procd_add_reload_trigger makes `uci apply singbox-ui` fire `reload` =
# reload_service (its pre-flight conflict check and lifecycle lock included), so
# Apply reloads the daemon and reconciles nft the same way cron already does.
service_triggers() {
	procd_add_reload_trigger "singbox-ui"
}

__do_start() {
	mkdir -p /tmp/singbox-ui

	# Self-heal the package-owned built-in rule-sets. uci-defaults/92 seeds them
	# on first install, but OpenWrt deletes that file afterwards — so a wiped or
	# hand-replaced /etc/config/singbox-ui came up with zero rule-sets and no way
	# to get them back. The seed is idempotent and only writes UCI when something
	# is actually missing (no flash churn on a normal boot), and honours the
	# default_rulesets master switch. Runs BEFORE generate.uc so this start sees
	# them. Never fatal.
	[ -x "$SEED_RULESETS_SH" ] && sh "$SEED_RULESETS_SH" 2>/dev/null

	# Refresh on (re)start, with short curl timeouts so boot stays snappy.
	# subscription.uc keeps prior sub_*.txt / rs_*.json files untouched on
	# failure, so generate.uc falls back to the cache.
	# #6: SINGBOX_FETCH_IF_STALE=1 makes these REUSE a still-fresh cache instead
	# of re-downloading. __do_start runs on every (re)start — a UI Apply reloads →
	# starts → would otherwise re-fetch every subscription/rule-set though the cron
	# refresh just did, hammering providers twice per tick. A missing cache reads
	# as stale, so first boot still fetches.
	SINGBOX_BOOT_FETCH=1 SINGBOX_FETCH_IF_STALE=1 ucode -L "$UCODE_LIB" "$SUBSCRIPTION_UC" fetch-subs &
	SINGBOX_BOOT_FETCH=1 SINGBOX_FETCH_IF_STALE=1 ucode -L "$UCODE_LIB" "$RULESETS_UC" fetch &
	wait

	# generate.uc exits 3 (EXIT_TRANSPARENT_CONFLICT, see generate.uc) ONLY for
	# the routing-ownership conflict — e.g. a tproxy inbound and a tun inbound
	# both claiming system routing — a config with no defined meaning, which it
	# refuses to build at all (bailing BEFORE writing /tmp/singbox-ui.json).
	# Refuse to start on THAT rc specifically: starting on the stale file would
	# report success while silently discarding the operator's edit.
	#
	# Any OTHER non-zero rc — e.g. a transient write failure (disk pressure),
	# where generate.uc deliberately left the previous good config in place and
	# logged "running stale" — falls through to the guards below
	# ([ ! -s ... ] and `sing-box check`), which already do the right thing:
	# start on the old config if it is still usable, refuse if it is not.
	# sing-box is a must-stay-up proxy (see the respawn policy below); a
	# 15-minute cron reload must not take the tunnel down over a hiccup that
	# left a perfectly good config sitting on disk.
	ucode -L "$UCODE_LIB" "$GENERATE_UC"
	_gen_rc=$?
	if [ "$_gen_rc" -eq 3 ]; then
		# Self-contained on purpose: generate.uc's own warn() goes to stderr, which
		# procd does NOT route to syslog, so "see the message above" pointed at a
		# line the operator never gets. The section names come from generate.uc's
		# structured event (event=config.transparent_conflict ... fix=...).
		logger -t singbox-ui "refusing to start: a tproxy inbound (nft_rules) and a tun inbound (auto_route) both claim system routing; exactly one may. Disable one — see event=config.transparent_conflict in the log for the section names and the fix."
		mkdir -p /var/lib/singbox-ui
		echo "{\"last_apply_ts\":$(date +%s),\"last_apply_result\":\"failed\"}" \
			> /var/lib/singbox-ui/apply_state.json
		return 1
	fi

	# If neither a fresh download nor a cached config produced anything,
	# refuse to start; cron will re-run subscription.uc in ≤30 min and call
	# `reload`, which triggers start_service again.
	if [ ! -s /tmp/singbox-ui.json ]; then
		logger -t singbox-ui "refusing to start: no cached config and fetch failed"
		return 1
	fi

	# S6.1: validate the config semantically before handing it to procd. A
	# well-formed-but-rejected config (unknown field, dangling reference, bad
	# value) would otherwise make procd respawn sing-box in a tight loop. Refuse
	# to start instead and let cron/reload retry in ≤30 min. S1.1: record the
	# real apply outcome in apply_state.json (distinct from generate's state).
	mkdir -p /var/lib/singbox-ui
	if ! "$SINGBOX_BIN" check -c /tmp/singbox-ui.json 2>/tmp/singbox-ui.check.err; then
		logger -t singbox-ui "refusing to start: sing-box rejected config"
		logger -t singbox-ui "sing-box check: $(head -c 300 /tmp/singbox-ui.check.err 2>/dev/null)"
		echo "{\"last_apply_ts\":$(date +%s),\"last_apply_result\":\"failed\"}" \
			> /var/lib/singbox-ui/apply_state.json
		return 1
	fi

	# Apply nft unconditionally. cmd_apply already does the right thing in every
	# case: when no tproxy/tun inbound needs the core table it DROPS any stale one
	# (the old `needed=0 -> remove` branch) AND — crucially — still applies any
	# plugin-contributed nft fragments. The old `needed` branch called `remove`,
	# which skips fragments entirely, so in TUN-only mode (no tproxy) a plugin's
	# table (e.g. awg_warp's) was absent after boot until the first */15 cron
	# apply — up to 15 min of missing rules. One call, both behaviours, gap closed.
	# apply's atomic `add+delete+table` prelude self-replaces the table on failure,
	# so a stale table from a prior start won't linger.
	ucode -L "$UCODE_LIB" "$NFTABLES_UC" apply
	_nft_rc=$?
	[ "$_nft_rc" = 0 ] || logger -t singbox-ui "nft apply failed (rc=$_nft_rc)"

	# Phase E: reconcile plugin-managed resources (e.g. AWG-WARP interfaces) before
	# the daemon starts. Idempotent; never fatal.
	ucode -L "$UCODE_LIB" "$APPLY_PLUGINS_UC" apply 2>/dev/null || \
		logger -t singbox-ui "apply-plugins apply returned non-zero"

	procd_open_instance
	# C3.6: drop to minimal capability set so sing-box runs without root.
	# We intentionally do NOT switch user/group to nobody/nogroup here —
	# that requires fixing FS-permissions on /tmp/singbox-ui.json and the
	# /tmp/singbox-ui/ subscription cache, which could break test envs.
	# Capabilities-only is a real security win without that risk.
	procd_set_param capabilities /etc/capabilities/singbox-ui.json
	procd_set_param command "$SINGBOX_BIN" run -c /tmp/singbox-ui.json
	# missed-2: explicit respawn policy. sing-box is a must-stay-up proxy and
	# the `sing-box check` gate above already prevents config-rejection respawn
	# loops, so we keep retrying indefinitely (retry=0) instead of letting
	# procd's default give up after ~5 crashes/hour and leave the tunnel down.
	# Args: <threshold-s> <cooldown-s> <retry: 0 = unlimited>.
	procd_set_param respawn 3600 5 0
	procd_close_instance

	# C3.3: record service-start timestamp for status_detail RPC. S1.1: the
	# config passed `sing-box check` above and was handed to procd, so record the
	# real apply result here — status_detail surfaces this as last_apply_result,
	# distinct from generate.uc's last_generate_result.
	mkdir -p /var/lib/singbox-ui
	echo "{\"service_start_ts\":$(date +%s)}" > /var/lib/singbox-ui/service_state.json
	echo "{\"last_apply_ts\":$(date +%s),\"last_apply_result\":\"ok\"}" \
		> /var/lib/singbox-ui/apply_state.json

	# Cache the package version once per start so status_detail (a hot read
	# RPC) doesn't fork apk on every call. Refreshed here so an upgrade +
	# restart re-derives it. (spec S5-PERF). OpenWrt 25.12.3 ships apk, not
	# opkg; `apk list --installed` prints "<name>-<version> noarch {...}".
	# Must yield the SAME cache format as cached_pkg_version() in the rpcd
	# handler (luci-singbox-ui/root/usr/libexec/rpcd/singbox-ui): the version
	# with the package-name prefix stripped. KEEP THE TWO IN SYNC — audit 13.2
	# (cross-linked); test_status_detail.sh asserts byte-identical output of
	# both paths for a fixture apk line.
	# audit 13.2: `\([^ ]*\).*` (no leading space before `.*`) captures the
	# first whitespace-delimited token even on a single-token line with no
	# trailing space — matching the rpcd split(line," ")[0] behaviour. The old
	# ` .*` form required a trailing space and would emit nothing on such a line.
	# The installed name is luci-app-singbox-ui; luci-singbox-ui is only the
	# pre-split provides/replaces alias, so the old query matched nothing and the
	# version was always "unknown". Mirror of the PKG constant in the rpcd handler.
	apk list --installed luci-app-singbox-ui 2>/dev/null \
		| sed -n 's/^luci-app-singbox-ui-\([^ ]*\).*/\1/p;q' \
		> /var/lib/singbox-ui/pkg_version || true
}

stop_service() {
	_lc_acquire
	# G7: nftables.uc remove prints "No such file or directory" on a
	# fresh stop (no table to delete). Symmetric with start_service
	# (line above already suppresses); keep operator logs quiet.
	ucode -L "$UCODE_LIB" "$NFTABLES_UC" remove 2>/dev/null
	ucode -L "$UCODE_LIB" "$APPLY_PLUGINS_UC" teardown 2>/dev/null || true
	_lc_release
}

# MUST be named reload_service: that is the ONLY hook rc.common looks up on
# `<init> reload`. With any other name (it used to be `reload_config`, which
# procd/rc.common know nothing about) reload silently falls through to plain
# `start` — and since our procd instance params never change (the command is
# always `sing-box run -c /tmp/singbox-ui.json`), procd considers the running
# instance up-to-date and does NOT restart it. Result: generate.uc rewrites the
# config, but the daemon keeps serving the OLD one, so a freshly imported
# subscription is in the config yet invisible in the dashboard (which reads the
# live clash_api) until someone hits Restart by hand. Every reload path is
# affected: both */15 cron jobs and subscription.uc's post-fetch reload.
reload_service() {
	# sing-box does not support signal-based config reload. Hold the
	# lifecycle lock across the WHOLE stop+start (missed-1) so a concurrent
	# reload/restart/boot cannot interleave its own stop+start in the gap.
	# The lock is re-entrant, so the nested stop/start below do not deadlock.
	_lc_acquire

	# Pre-flight the FULL config BEFORE `stop`, not after. `stop` removes our
	# `inet singbox_ui` table and the daemon; if a bad config were only caught
	# INSIDE `start` (which regenerates and runs `sing-box check` post-stop), the
	# box would already have no daemon and no table — the LAN egressing UNPROXIED
	# — before we discovered the config is unusable. And it self-reproduces: the
	# same UCI drives the same bad config on every */15 cron reload. Two failure
	# modes reach this:
	#   - transparent-ownership conflict: generate.uc exits 3 (bails before writing);
	#   - well-formed but core-rejected: unknown field on an old core, dangling
	#     ref, a fail-open version gate, the user's json_extra — generate.uc emits
	#     it happily but `sing-box check` refuses it.
	# Build to a TEMP path and validate it here; refuse the reload on either,
	# leaving the daemon serving the last known-good config with its table intact.
	# This full generate subsumes the old `check-conflict` mode (generate.uc still
	# exits 3 on conflict before building). The double generate (temp here, prod
	# in `start`) is the accepted price. (Boot is different: __do_start has nothing
	# to preserve, so it refuses to start at all.)
	#
	# Fail-open on everything else: a generate rc other than 0/3 (a temp-write
	# hiccup) or a missing core binary falls through to the normal stop+start and
	# its own guards — a broken pre-flight must not become a broken reload.
	_pf=/tmp/singbox-ui/.preflight.json
	SINGBOX_CONFIG="$_pf" ucode -L "$UCODE_LIB" "$GENERATE_UC"
	_chk_rc=$?
	if [ "$_chk_rc" -eq 3 ]; then
		logger -t singbox-ui "refusing to reload: a tproxy inbound (nft_rules) and a tun inbound (auto_route) both claim system routing; exactly one may. Keeping the running config and its nft rules — disable one and re-apply (see event=config.transparent_conflict in the log for the section names and the fix)."
		rm -f "$_pf"
		_lc_release
		return 1
	fi
	if [ "$_chk_rc" -eq 0 ] && [ -x "$SINGBOX_BIN" ] && \
		! "$SINGBOX_BIN" check -c "$_pf" 2>/tmp/singbox-ui.reload.check.err; then
		logger -t singbox-ui "refusing to reload: sing-box rejected the new config; keeping the running config. $(head -c 200 /tmp/singbox-ui.reload.check.err 2>/dev/null)"
		rm -f "$_pf"
		_lc_release
		return 1
	fi
	rm -f "$_pf"

	stop
	start
	_lc_release
}

# `restart` had the SAME teardown hole, and it is not academic: the rpcd `restart`
# method — the UI's "Restart service" button — goes through it. rc.common offers
# no `restart_service` hook; its `restart` is a hardcoded `stop; start`, defined
# BEFORE the init script is sourced and NOT re-defined by the USE_PROCD block, so
# this override wins. A restart IS a stop+start, so route it through
# reload_service and inherit the pre-flight conflict check and the lifecycle lock
# — otherwise one button press on a conflicting UCI still strips the nft table
# and leaves the daemon down. (`trap '' TERM` is rc.common's: don't get killed
# half-way through the stop.)
restart() {
	trap '' TERM
	reload_service
	_rs_rc=$?
	trap - TERM
	return "$_rs_rc"
}
