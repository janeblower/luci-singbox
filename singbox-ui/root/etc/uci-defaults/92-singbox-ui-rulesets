#!/bin/sh
# First-install seed of the built-in rule-sets. The actual logic lives in a
# PERSISTENT script (uci-defaults are deleted after their first successful run,
# which is exactly why a config wipe used to leave the box with no rule-sets):
# init.d start_service calls the same script on every start so they self-heal.
# Keeping this thin wrapper means a fresh install still has the sets before the
# service ever starts. Env (incl. the SINGBOX_UCI test seam) is inherited.
SEED=/usr/share/singbox-ui/seed-rulesets.sh
# Fall back to the in-tree copy so the test/dev sandbox (which runs this file
# straight from the checkout, where the absolute path does not exist) still works.
[ -x "$SEED" ] || SEED="$(dirname "$0")/../../usr/share/singbox-ui/seed-rulesets.sh"
sh "$SEED"
exit 0
