#!/bin/sh
# Seed the built-in rule-sets from itdoginfo/allow-domains.
#
# They are ordinary `ruleset` sections carrying `option builtin '1'`, which the
# UI renders read-only (no Edit/Delete) and the backend gates on the
# singbox-ui.main.default_rulesets master switch (helpers.ruleset_active).
#
# The URLs point at the release channel's `latest` alias, so a new upstream
# release is picked up without touching the config; sing-box re-fetches each
# .srs on its own update_interval.
#
# Nothing is downloaded here, and nothing is downloaded later either unless a
# route/DNS rule actually references the set — ruleset.uc only emits
# route.rule_set entries for referenced tags. Everything but the two the seed
# config already wires up therefore ships disabled.
#
# Idempotent: a section that already exists is left alone (a user who enabled
# `porn` must not have it flipped back off by a package upgrade). Honours the
# master switch: with default_rulesets=0 nothing is created at all.

BASE='https://github.com/itdoginfo/allow-domains/releases/latest/download'
INTERVAL='86400'

# The two the seed config already references (etc/config/singbox-ui:
# defaults_direct / defaults_fakeip) ship enabled; the rest are inert until the
# user points a rule at them.
SETS='anime block cloudflare cloudfront digitalocean discord geoblock google_ai
      google_meet google_play hdrezka hetzner hodca meta news ovh porn roblox
      russia_inside russia_outside telegram tiktok twitter ukraine_inside youtube'

[ "$(uci -q get singbox-ui.main.default_rulesets)" = "0" ] && exit 0

uci -q get singbox-ui.main >/dev/null || uci -q set singbox-ui.main='singbox-ui'
uci -q get singbox-ui.main.default_rulesets >/dev/null \
	|| uci -q set singbox-ui.main.default_rulesets='1'

for name in $SETS; do
	# Already present (fresh install seeds russia_inside/discord from
	# etc/config, or this script ran on a previous upgrade): only stamp the
	# builtin marker, never touch enabled/url — that is the user's to own.
	if uci -q get "singbox-ui.$name" >/dev/null; then
		uci -q set "singbox-ui.$name.builtin"='1'
		continue
	fi
	uci -q set "singbox-ui.$name"='ruleset'
	uci -q set "singbox-ui.$name.builtin"='1'
	uci -q set "singbox-ui.$name.enabled"='0'
	uci -q set "singbox-ui.$name.type"='remote'
	uci -q set "singbox-ui.$name.url"="$BASE/$name.srs"
	uci -q set "singbox-ui.$name.nft_rules"='0'
	uci -q set "singbox-ui.$name.update_interval"="$INTERVAL"
done

uci -q commit singbox-ui
exit 0
