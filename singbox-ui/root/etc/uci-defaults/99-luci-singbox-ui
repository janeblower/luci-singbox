#!/bin/sh
# Run by OpenWrt on first boot after package install. Removes itself on success.

# ---------------------------------------------------------------------------
# Schema version sentinel (Phase C2.1.2).
# Bump CURRENT_SCHEMA when a new migration is added below. Old installs have
# no _meta section and are treated as version 0. If the installed version is
# already >= CURRENT_SCHEMA, every migration is a no-op and we exit early —
# this is the canonical idempotency guarantee. (Individual data-shape guards
# inside each migration_*() are kept as defence-in-depth.)
#
# The ladder used to carry ten more steps for legacy shapes older than schema
# 15 (fakeip list->option, tproxy->inbound, expose_*, fakeip/dns_outbound ->
# dns_server, ruleset.dns_fakeip, extra_json, inbound mode/json, proxy_type ->
# type) plus migrate_drop_removed_protocols. They are gone. The last one was
# not merely dead weight, it was actively destructive: it deleted EVERY inbound
# with protocol=tun|vmess and every outbound of type vmess|tuic|anytls|ssh|
# interface. All of those protocols came BACK (tun.uc, vmess.uc, tuic.uc,
# anytls.uc, ssh.uc all exist and are in the UI dropdowns), so on a fresh
# install — where the shipped config has no _meta, hence cur_ver=0 — the very
# first boot deleted the seeded tun_in, and on any upgrade from schema <19 it
# deleted live user outbounds. `interface` is the only type that never came
# back, and nothing writes it any more now that proxy_type->type is gone.
# ---------------------------------------------------------------------------
CURRENT_SCHEMA=19

# uci CLI does not honour UCI_CONFIG_DIR, so tests need an explicit seam (the
# same one seed-rulesets.sh uses). Default is the real binary. Without it this
# whole file could only ever be exercised against the live /etc/config, which
# is why its cross-tests were gated on `command -v uci` and therefore never ran.
# shellcheck disable=SC2086  # SINGBOX_UCI deliberately carries flags (-c <dir>)
UCI="${SINGBOX_UCI:-uci}"
uci_() { $UCI "$@"; }

cur_ver=$(uci_ -q get singbox-ui._meta.schema_version 2>/dev/null || echo 0)
case "$cur_ver" in
	''|*[!0-9]*) cur_ver=0 ;;
esac

if [ "$cur_ver" -ge "$CURRENT_SCHEMA" ]; then
	exit 0
fi

# Force LuCI's RPC ACL cache to reload so the menu entry appears immediately.
rm -f /tmp/luci-indexcache /tmp/luci-modulecache/* 2>/dev/null

# Reload rpcd so the new ACL JSON is picked up.
/etc/init.d/rpcd reload >/dev/null 2>&1

# ---------------------------------------------------------------------------
# Create default sections for Phase 2 features if they don't exist yet.
# These match `etc/config/singbox-ui` defaults and let users see the sections
# in LuCI without manually editing UCI.
# ---------------------------------------------------------------------------
ensure_section() {
	# $1 = section name, $2 = section type
	# Returns 0 if newly created, 1 if it already existed (caller can branch).
	if ! uci_ -q get "singbox-ui.$1" >/dev/null 2>&1; then
		uci_ -q set "singbox-ui.$1=$2"
		return 0
	fi
	return 1
}

if ensure_section log log; then
	uci_ -q set singbox-ui.log.enabled='1'
	uci_ -q set singbox-ui.log.level='info'
fi

if ensure_section cache cache; then
	uci_ -q set singbox-ui.cache.enabled='0'
	uci_ -q set singbox-ui.cache.path='/tmp/singbox-ui-cache.db'
fi

# Phase E: ensure the 'plugins' manager section exists.
ensure_section plugins singbox-ui

# ---------------------------------------------------------------------------
# Ensure a clash_api section exists and has a stable random secret.
# ---------------------------------------------------------------------------
if ensure_section clash_api clash_api; then
	uci_ -q set singbox-ui.clash_api.enabled='0'
	uci_ -q set singbox-ui.clash_api.listen='127.0.0.1'
	uci_ -q set singbox-ui.clash_api.port='9090'
fi

ensure_clash_api_secret() {
	[ "$(uci_ -q get singbox-ui.clash_api 2>/dev/null)" = "clash_api" ] || return 0
	_sec=$(uci_ -q get singbox-ui.clash_api.secret 2>/dev/null || true)
	[ -n "$_sec" ] && return 0
	_new=$(head -c16 /dev/urandom 2>/dev/null | hexdump -v -e '/1 "%02x"' 2>/dev/null)
	[ -n "$_new" ] || _new=$(date +%s)$$
	uci_ -q set singbox-ui.clash_api.secret="$_new"
}
ensure_clash_api_secret

# ---------------------------------------------------------------------------
# Cache file migration: convert legacy `cache` (often disabled + explicit
# /tmp path) into the new storage-mode model. Idempotent.
# ---------------------------------------------------------------------------
migrate_cache_storage() {
	[ "$(uci_ -q get singbox-ui.cache 2>/dev/null)" = "cache" ] || \
		uci_ -q set singbox-ui.cache='cache'

	# If storage is already set, the user (or this script) has migrated.
	[ -n "$(uci_ -q get singbox-ui.cache.storage 2>/dev/null)" ] && return 0

	_was_legacy=0
	_path=$(uci_ -q get singbox-ui.cache.path 2>/dev/null || true)
	case "$_path" in
		""|"/tmp/singbox-ui-cache.db")
			uci_ -q set singbox-ui.cache.storage='ram'
			uci_ -q delete singbox-ui.cache.path 2>/dev/null || true
			_was_legacy=1 ;;
		"/etc/sing-box/cache.db")
			uci_ -q set singbox-ui.cache.storage='flash'
			uci_ -q delete singbox-ui.cache.path 2>/dev/null || true ;;
		*)
			uci_ -q set singbox-ui.cache.storage='custom' ;;
	esac

	# Only flip the shipped-default disabled state. A user who explicitly
	# disabled cache after customising path keeps their setting.
	if [ "$_was_legacy" = "1" ]; then
		uci_ -q set singbox-ui.cache.enabled='1'
	fi

	# store_fakeip default: only set if absent.
	_sf=$(uci_ -q get singbox-ui.cache.store_fakeip 2>/dev/null || echo '')
	[ "$_sf" = "" ] && uci_ -q set singbox-ui.cache.store_fakeip='1'
}
migrate_cache_storage

# ---------------------------------------------------------------------------
# Create the default DNS inbound for upgrades. Idempotent: skip if a
# section with that name already exists (user may have customised it).
# ---------------------------------------------------------------------------
ensure_dns_inbound() {
	[ -n "$(uci_ -q get singbox-ui.dns_in 2>/dev/null)" ] && return 0
	uci_ -q set singbox-ui.dns_in='inbound'
	uci_ -q set singbox-ui.dns_in.enabled='1'
	uci_ -q set singbox-ui.dns_in.protocol='direct'
	uci_ -q set singbox-ui.dns_in.listen='127.0.0.53'
	uci_ -q set singbox-ui.dns_in.listen_port='53'
	uci_ -q set singbox-ui.dns_in.network='udp'
	uci_ -q set singbox-ui.dns_in.dns_listener='1'
}
ensure_dns_inbound

# ---------------------------------------------------------------------------
# Phase E2 (migration A): rename UCI keys on surviving protocols so the new
# descriptors (T7–T13) can read them. Idempotent: each rename only fires
# while the old key is still set. Cannot be dropped: a box on schema 15 still
# holds `security`/`transport`/`utls_fingerprint`, which no descriptor reads —
# it would lose TLS and its transport silently.
# ---------------------------------------------------------------------------
migrate_rename_e2_keys() {
	local sid

	for sid in $(uci_ -q show singbox-ui 2>/dev/null \
		| sed -n 's/^singbox-ui\.\([^.]*\)=inbound$/\1/p; s/^singbox-ui\.\([^.]*\)=outbound$/\1/p'); do

		# transport → transport_type
		local tv
		tv=$(uci_ -q get "singbox-ui.$sid.transport" 2>/dev/null || true)
		if [ -n "$tv" ] && [ -z "$(uci_ -q get "singbox-ui.$sid.transport_type" 2>/dev/null || true)" ]; then
			uci_ -q set "singbox-ui.$sid.transport_type=$tv"
			uci_ -q delete "singbox-ui.$sid.transport"
			# httpupgrade host key split
			if [ "$tv" = "httpupgrade" ]; then
				local hv
				hv=$(uci_ -q get "singbox-ui.$sid.transport_host" 2>/dev/null || true)
				if [ -n "$hv" ]; then
					uci_ -q set "singbox-ui.$sid.transport_host_httpupgrade=$hv"
					uci_ -q delete "singbox-ui.$sid.transport_host"
				fi
			fi
		fi

		# tls_ech → tls_ech_enabled
		local ev
		ev=$(uci_ -q get "singbox-ui.$sid.tls_ech" 2>/dev/null || true)
		if [ -n "$ev" ] && [ -z "$(uci_ -q get "singbox-ui.$sid.tls_ech_enabled" 2>/dev/null || true)" ]; then
			uci_ -q set "singbox-ui.$sid.tls_ech_enabled=$ev"
			uci_ -q delete "singbox-ui.$sid.tls_ech"
		fi

		# security → tls_enabled + reality_enabled
		local sec
		sec=$(uci_ -q get "singbox-ui.$sid.security" 2>/dev/null || true)
		if [ -n "$sec" ]; then
			case "$sec" in
				tls)
					uci_ -q set "singbox-ui.$sid.tls_enabled=1"
					;;
				reality)
					uci_ -q set "singbox-ui.$sid.tls_enabled=1"
					uci_ -q set "singbox-ui.$sid.reality_enabled=1"
					;;
			esac
			uci_ -q delete "singbox-ui.$sid.security"
		fi

		# utls_fingerprint set → utls_enabled=1 (preserve the value)
		local uf
		uf=$(uci_ -q get "singbox-ui.$sid.utls_fingerprint" 2>/dev/null || true)
		if [ -n "$uf" ] && [ -z "$(uci_ -q get "singbox-ui.$sid.utls_enabled" 2>/dev/null || true)" ]; then
			uci_ -q set "singbox-ui.$sid.utls_enabled=1"
		fi
	done

	return 0
}

migrate_rename_e2_keys

# ---------------------------------------------------------------------------
# Finalise (Phase C2.1.3): set the schema version sentinel and commit ONCE.
# All migrations above were pure in-memory edits, so this single commit is
# the only point at which UCI files are rewritten — crash-safe between
# migrations. Also covers the fresh-install case (no migrations fired) by
# initialising _meta unconditionally.
# ---------------------------------------------------------------------------
uci_ -q set singbox-ui._meta='_meta'
uci_ -q set singbox-ui._meta.schema_version="$CURRENT_SCHEMA"
uci_ commit singbox-ui

logger -t singbox-ui "event=migration.completed ts=$(date +%s) schema_version=$CURRENT_SCHEMA"

exit 0
