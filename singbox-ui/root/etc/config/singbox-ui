config inbound 'tproxy_in'
	option enabled '1'
	option protocol 'tproxy'
	option listen '::'
	option listen_port '7893'
	list   interface 'br-lan'
	option hijack_dns '1'
	option nft_rules '1'

# NO default routing is shipped: no outbound, no route rules, no route_default.
#
# The routing this used to ship was wrong, and wrong in the direction that
# silently does nothing. It sent `russia_inside` straight out the WAN — but
# `russia_inside` is not "Russian domains, send them direct", it is
# itdoginfo's list of what is BLOCKED for a user inside Russia (a superset of
# anime/block/geoblock/news/porn/hdrezka/meta/tiktok/twitter/youtube/discord).
# Those are exactly the domains that need a proxy, and the seed routed them
# around it.
#
# A correct default cannot be shipped either: it would have to point at a proxy,
# and a fresh install has none (route.uc drops an action=route rule with no
# outbound). So the box comes up with the 25 built-in rule-sets ready and no
# opinion about how to use them. sing-box accepts a config with no outbounds —
# generate.uc injects the implicit `direct` and traffic flows normally.
#
# The rule-sets themselves are created by uci-defaults/92-singbox-ui-rulesets
# (all 25, enabled). An enabled rule-set nobody references is neither emitted into
# the config nor downloaded, so this costs nothing and needs no wiring here.

config inbound 'dns_in'
	option enabled '1'
	option protocol 'direct'
	option listen '127.0.0.53'
	option listen_port '53'
	option network 'udp'
	option dns_listener '1'

config dns_server 'fakeip'
	option enabled '1'
	option type 'fakeip'
	option inet4_range '198.18.0.0/15'
	option inet6_range 'fc00::/18'

config dns_server 'google'
	option enabled '1'
	option type 'https'
	# Numeric server avoids a chicken-and-egg bootstrap (no DNS-to-resolve-DNS).
	# Detour intentionally unset: pointing at the auto-injected `direct`
	# outbound is rejected by sing-box 1.12 ("detour to an empty direct
	# outbound makes no sense"). Users who want this query pinned to a
	# specific WAN should set `detour` to a user-defined outbound.
	option server '8.8.8.8'
	option server_port '443'
	option path '/dns-query'

# The fakeip DNS server is defined and ready, but NO dns_rule points anything at
# it. It used to send russia_inside/discord queries there — the DNS half of the
# same broken default. And fakeip without routing is worse than useless: it hands
# the client a 198.18.x.x address that only means something once the connection is
# captured and mapped back, so the moment the capture is off (or the route rule is
# missing, as it now is) those domains are simply dead. Point a dns_rule at it
# once you have a proxy to route the answers through.

config dns 'dns'
	option final 'google'
	option strategy 'prefer_ipv4'

config log 'log'
	option enabled '1'
	option level 'info'

config cache 'cache'
	option enabled '1'
	option storage 'ram'
	option store_fakeip '1'

config clash_api 'clash_api'
	option enabled '0'
	option listen '127.0.0.1'
	option port '9090'

config subscriptions 'subscriptions'
	option auto_update '1'

config singbox-ui 'main'
	option ui_compat_only '0'
	option default_rulesets '1'

config singbox-ui 'plugins'
	# Phase E plugin manager. Per-plugin enable flags live here as
	# '<name>_enabled'. Seeded by 99-luci-singbox-ui.
