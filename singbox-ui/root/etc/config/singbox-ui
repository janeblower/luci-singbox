config inbound 'tproxy_in'
	option enabled '1'
	option protocol 'tproxy'
	option listen '::'
	option listen_port '7893'
	list   interface 'br-lan'
	option hijack_dns '1'
	option nft_rules '1'

# TUN — the ALTERNATIVE to tproxy, shipped DISABLED. It is not a companion to the
# inbound above: system routing has exactly one owner. Enabling this means turning
# the tproxy inbound's nftables rules off (the UI enforces it — the loser's
# checkbox goes dead and names the winner; generate.uc refuses to build a config
# where both claim it, and init.d refuses to start on that refusal). With
# auto_route + auto_redirect sing-box installs its OWN nftables rules — fw4
# compatibility rules included — so none of our `inet singbox_ui` table is used.
#
# Shipped off because turning it on would change how a fresh install behaves, and
# because it needs kmod-tun (a hard dependency, so /dev/net/tun is there — but the
# box may still not want a tunnel). Flip `enabled` here and on tproxy_in to switch.
#
# auto_route/auto_redirect are DELIBERATELY ABSENT — do not "helpfully" pre-arm
# them. `enabled` is a live checkbox in the inbounds GRID; `auto_route` is
# `modalonly` and is only ever touched by opening the modal. If the seed pre-wrote
# auto_route '1' here, ticking `enabled` alone would be enough to make this
# section claim system routing too — colliding with the seeded, enabled
# tproxy_in and tripping generate.uc's ownership guard (rc 3), which init.d
# refuses to start on. Net effect of one grid click: no sing-box, no nftables
# table, LAN traffic leaves unproxied. An enabled-but-unrouted tun is inert and
# safe; a route on the seed's behalf is not something we get to hand out for
# free while tproxy is already holding it. To actually route, open the modal:
# there `makeExclusive` disables `auto_route` and names tproxy_in as the current
# owner until its `nft_rules` is turned off — that's the flow this feature is
# built around. Ticking it there writes an explicit `auto_route '1'` (default is
# 0, so LuCI persists a value that differs from it — see tun.uc). hijack_dns has
# no such hazard (no ownership group) and is written out explicitly so the
# seeded tun has a sensible starting value the moment auto_route is turned on.
config inbound 'tun_in'
	option enabled '0'
	option protocol 'tun'
	list   address '172.19.0.1/30'
	list   address 'fdfe:dcba:9876::1/126'
	option interface_name 'singbox-tun'
	option stack 'system'
	option hijack_dns '1'

# NO default routing is shipped: no outbound, no route rules, no route_default.
#
# The routing this used to ship was wrong, and wrong in the direction that
# silently does nothing. It sent `russia_inside` straight out the WAN — but
# `russia_inside` is not "Russian domains, send them direct", it is
# itdoginfo's list of what is BLOCKED for a user inside Russia (a superset of
# anime/block/geoblock/news/porn/hdrezka/meta/tiktok/twitter/youtube/discord).
# Those are exactly the domains that need a proxy, and the seed routed them
# around it.
#
# A correct default cannot be shipped either: it would have to point at a proxy,
# and a fresh install has none (route.uc drops an action=route rule with no
# outbound). So the box comes up with the 25 built-in rule-sets ready and no
# opinion about how to use them. sing-box accepts a config with no outbounds —
# generate.uc injects the implicit `direct` and traffic flows normally.
#
# The rule-sets themselves are created by uci-defaults/92-singbox-ui-rulesets
# (all 25, enabled). An enabled rule-set nobody references is neither emitted into
# the config nor downloaded, so this costs nothing and needs no wiring here.

config inbound 'dns_in'
	option enabled '1'
	option protocol 'direct'
	option listen '127.0.0.53'
	option listen_port '53'
	option network 'udp'
	option dns_listener '1'

config dns_server 'fakeip'
	option enabled '1'
	option type 'fakeip'
	option inet4_range '198.18.0.0/15'
	option inet6_range 'fc00::/18'

config dns_server 'google'
	option enabled '1'
	option type 'https'
	# Numeric server avoids a chicken-and-egg bootstrap (no DNS-to-resolve-DNS).
	# Detour intentionally unset: pointing at the auto-injected `direct`
	# outbound is rejected by sing-box 1.12 ("detour to an empty direct
	# outbound makes no sense"). Users who want this query pinned to a
	# specific WAN should set `detour` to a user-defined outbound.
	option server '8.8.8.8'
	option server_port '443'
	option path '/dns-query'

# The fakeip DNS server is defined and ready, but NO dns_rule points anything at
# it. It used to send russia_inside/discord queries there — the DNS half of the
# same broken default. And fakeip without routing is worse than useless: it hands
# the client a 198.18.x.x address that only means something once the connection is
# captured and mapped back, so the moment the capture is off (or the route rule is
# missing, as it now is) those domains are simply dead. Point a dns_rule at it
# once you have a proxy to route the answers through.

config dns 'dns'
	option final 'google'
	option strategy 'prefer_ipv4'

config log 'log'
	option enabled '1'
	option level 'info'

config cache 'cache'
	option enabled '1'
	option storage 'ram'
	option store_fakeip '1'

config clash_api 'clash_api'
	option enabled '0'
	option listen '127.0.0.1'
	option port '9090'

config subscriptions 'subscriptions'
	option auto_update '1'

# Transparent-proxy mark. These are exactly the values nftables.uc already falls
# back to (safe_fwmark(..., 0x40000000)); they live here so they are visible and
# editable instead of being invented by a uci-defaults script that wrote the same
# numbers and then deleted itself. An existing install with no `global` section
# keeps working on the backend fallback, so nothing needs migrating.
config global
	option fwmark '0x40000000'
	option fwmark_mask '0x40000000'
	option redirect_router_traffic '0'

config singbox-ui 'main'
	option ui_compat_only '0'
	option default_rulesets '1'

config singbox-ui 'plugins'
	# Phase E plugin manager. Per-plugin enable flags live here as
	# '<name>_enabled'. Seeded by 99-luci-singbox-ui.
