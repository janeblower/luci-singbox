config inbound 'tproxy_in'
	option enabled '1'
	option protocol 'tproxy'
	option listen '::'
	option listen_port '7893'
	list   interface 'br-lan'
	option hijack_dns '1'
	option nft_rules '1'

# The two built-in rule-sets the default route/DNS rules actually reference, so
# they ship enabled. The other 23 from itdoginfo/allow-domains are seeded
# disabled by uci-defaults/92-singbox-ui-rulesets. `builtin '1'` makes the UI
# render them read-only and puts them under the main.default_rulesets switch.
config ruleset 'russia_inside'
	option builtin '1'
	option enabled '1'
	option type 'remote'
	option url 'https://github.com/itdoginfo/allow-domains/releases/latest/download/russia_inside.srs'
	option nft_rules '0'
	option update_interval '86400'

config ruleset 'discord'
	option builtin '1'
	option enabled '1'
	option type 'remote'
	option url 'https://github.com/itdoginfo/allow-domains/releases/latest/download/discord.srs'
	option nft_rules '1'
	option update_interval '86400'

# Built-in WAN outbound: a plain `direct`, deliberately with NO bind_interface.
# sing-box's bind_interface takes an OS netdev (eth0 / pppoe-wan / br-wan), not
# an OpenWrt logical interface name, and the netdev changes under you (pppoe
# reconnect, DHCP, multi-wan). Without a bind, egress follows the system routing
# table — which IS the WAN — and survives all of that.
#
# `builtin '1'` makes the UI lock the row (no Edit/Delete). generate.uc drops it
# from the config entirely once nothing references it, so pointing the Default
# route somewhere else makes it go away instead of lingering undeletable.
config outbound 'wan'
	option builtin '1'
	option enabled '1'
	option type 'direct'

config route_rule 'defaults_direct'
	option enabled '1'
	option type 'default'
	list   rule_set 'russia_inside'
	list   rule_set 'discord'
	option action 'route'
	option outbound 'wan'

# bypass (sing-box 1.13+) with an outbound behaves exactly like `route` for every
# connection that did not come from auto_redirect, and lets the kernel take the
# short path for the ones that did — sing-box picks whichever is better. On a core
# older than 1.13 the action is fatal (the config is refused outright, not
# ignored), so route.uc degrades it to `route` rather than let a fresh install
# come up with no service.
config route_default 'route_default'
	option action 'bypass'
	option outbound 'wan'

config inbound 'dns_in'
	option enabled '1'
	option protocol 'direct'
	option listen '127.0.0.53'
	option listen_port '53'
	option network 'udp'
	option dns_listener '1'

config dns_server 'fakeip'
	option enabled '1'
	option type 'fakeip'
	option inet4_range '198.18.0.0/15'
	option inet6_range 'fc00::/18'

config dns_server 'google'
	option enabled '1'
	option type 'https'
	# Numeric server avoids a chicken-and-egg bootstrap (no DNS-to-resolve-DNS).
	# Detour intentionally unset: pointing at the auto-injected `direct`
	# outbound is rejected by sing-box 1.12 ("detour to an empty direct
	# outbound makes no sense"). Users who want this query pinned to a
	# specific WAN should set `detour` to a user-defined outbound.
	option server '8.8.8.8'
	option server_port '443'
	option path '/dns-query'

config dns_rule 'defaults_fakeip'
	option enabled '1'
	option type 'default'
	list   rule_set 'russia_inside'
	list   rule_set 'discord'
	option action 'route'
	option server 'fakeip'

config dns 'dns'
	option final 'google'
	option strategy 'prefer_ipv4'

config log 'log'
	option enabled '1'
	option level 'info'

config cache 'cache'
	option enabled '1'
	option storage 'ram'
	option store_fakeip '1'

config clash_api 'clash_api'
	option enabled '0'
	option listen '127.0.0.1'
	option port '9090'

config subscriptions 'subscriptions'
	option auto_update '1'

config singbox-ui 'main'
	option ui_compat_only '0'
	option default_rulesets '1'

config singbox-ui 'plugins'
	# Phase E plugin manager. Per-plugin enable flags live here as
	# '<name>_enabled'. Seeded by 99-luci-singbox-ui.
